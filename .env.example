# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored --- do not commit real credentials.

# --- Application ---
SERVER_PORT=4000

# --- Database (consumed by both the app and the postgres service) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devtest
DB_USER_NAME=devuser
